<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <!-- Mejor para accesibilidad: evitar user-scalable=no -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parking Pro 3.0</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        :root { --bg: #0f172a; --card: #1e293b; --accent: #38bdf8; --danger: #f43f5e; --success: #22c55e; }
        body { font-family: system-ui, sans-serif; background: var(--bg); color: white; text-align: center; margin: 0; padding: 15px; }
        .container { max-width: 400px; margin: auto; background: var(--card); padding: 20px; border-radius: 20px; border: 1px solid #334155; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        #map { height: 200px; border-radius: 15px; margin: 15px 0; border: 1px solid #334155; }
        input { background: #0f172a; border: 1px solid #334155; color: white; padding: 12px; border-radius: 10px; width: 80px; font-size: 1.2rem; text-align: center; }
        button { width: 100%; padding: 15px; border-radius: 12px; border: none; font-weight: bold; cursor: pointer; margin: 8px 0; font-size: 1rem; }
        .btn-go { background: var(--success); color: white; }
        .btn-stop { background: var(--danger); color: white; display: none; }
        #timer { font-size: 3rem; font-weight: bold; color: var(--danger); margin: 10px 0; font-variant-numeric: tabular-nums; }
        .nav-link { background: var(--accent); color: white; text-decoration: none; display: block; padding: 15px; border-radius: 12px; font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>

<div class="container">
    <h2>🚗 Parking Pro 3.0</h2>
    <div id="setup">
        <label>Minutos totales:</label><br>
        <input type="number" id="mins" value="6" min="1" inputmode="numeric" aria-label="Minutos">
        <button class="btn-go" onclick="iniciar()">📍 GUARDAR Y ACTIVAR</button>
    </div>
    
    <div id="active-ui" style="display:none">
        <div id="timer">00:00</div>
        <button id="btnDetener" class="btn-stop" onclick="detenerTodo()">🔕 DETENER ALARMA</button>
    </div>

    <div id="map"></div>
    <button class="nav-link" onclick="navegar()">🧭 REGRESAR AL AUTO</button>
</div>

<audio id="audioAlarma" loop preload="auto">
    <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
</audio>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let map, marker, countdown;
    const audio = document.getElementById('audioAlarma');
    const btnDetener = document.getElementById('btnDetener');

    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('sw.js')
            .then(reg => console.log("SW Listo"))
            .catch(err => console.warn("Error registrando SW:", err));
    }

    async function iniciar() {
        try {
            const permission = await Notification.requestPermission();
            if (permission !== 'granted') return alert("Necesito permisos de notificación");

            navigator.geolocation.getCurrentPosition(
                pos => {
                    const minsRaw = document.getElementById('mins').value;
                    const mins = parseInt(minsRaw, 10);
                    if (!Number.isFinite(mins) || mins <= 0) {
                        return alert("Introduce un número válido de minutos mayor que 0");
                    }

                    const ms = mins * 60000;
                    const fin = Date.now() + ms;

                    localStorage.setItem('p_fin', String(fin));
                    localStorage.setItem('p_lat', String(pos.coords.latitude));
                    localStorage.setItem('p_lng', String(pos.coords.longitude));

                    mostrarMapa(pos.coords.latitude, pos.coords.longitude);

                    // COMUNICAR CON EL SERVICE WORKER (si hay controlador)
                    if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                        navigator.serviceWorker.controller.postMessage({ 
                            type: 'PROGRAMAR_ALERTAS', 
                            msTotales: ms,
                            fin: fin,
                            lat: pos.coords.latitude,
                            lng: pos.coords.longitude
                        });
                    }

                    // Desbloqueo de Audio forzado por interacción (manejo de errores)
                    audio.play()
                        .then(() => { audio.pause(); audio.currentTime = 0; })
                        .catch((e) => { console.warn("audio.play() rechazado:", e); });

                    document.getElementById('setup').style.display = 'none';
                    document.getElementById('active-ui').style.display = 'block';
                    btnDetener.style.display = 'none'; // ocultar hasta que suene

                    reproducirContador();
                },
                err => {
                    console.warn("Geolocalización falló:", err);
                    alert("No pude obtener la ubicación. Verifica permisos o intenta de nuevo.");
                },
                { timeout: 10000, maximumAge: 0 }
            );
        } catch (err) {
            console.error("Error en iniciar():", err);
            alert("Ocurrió un error al solicitar permisos.");
        }
    }

    function reproducirContador() {
        if (countdown) clearInterval(countdown);
        countdown = setInterval(() => {
            const fin = Number(localStorage.getItem('p_fin'));
            if (!Number.isFinite(fin)) {
                clearInterval(countdown);
                document.getElementById('timer').innerText = "00:00";
                return;
            }

            const resto = fin - Date.now();
            
            if (resto <= 0) {
                document.getElementById('timer').innerText = "¡TIEMPO!";
                btnDetener.style.display = 'block';
                // Intentar reproducir audio (manejo de errores)
                audio.play().catch(e => console.warn("No se pudo reproducir audio:", e));
                clearInterval(countdown);
                return;
            }

            const m = Math.floor(resto / 60000);
            const s = Math.floor((resto % 60000) / 1000);
            document.getElementById('timer').innerText = `${m}:${s.toString().padStart(2,'0')}`;
        }, 1000);
    }

    function detenerTodo() {
        try {
            audio.pause();
            audio.currentTime = 0;
        } catch (e) { console.warn("Error al detener audio:", e); }
        clearInterval(countdown);
        localStorage.removeItem('p_fin');
        localStorage.removeItem('p_lat');
        localStorage.removeItem('p_lng');
        document.getElementById('setup').style.display = 'block';
        document.getElementById('active-ui').style.display = 'none';
        btnDetener.style.display = 'none';
    }

    function mostrarMapa(lat, lng) {
        const latN = parseFloat(lat);
        const lngN = parseFloat(lng);
        if (!Number.isFinite(latN) || !Number.isFinite(lngN)) return;

        if (!map) {
            map = L.map('map').setView([latN, lngN], 17);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
        }
        if (marker) map.removeLayer(marker);
        marker = L.marker([latN, lngN]).addTo(map);
        map.panTo([latN, lngN]);
    }

    function navegar() {
        const lat = localStorage.getItem('p_lat');
        const lng = localStorage.getItem('p_lng');
        if (lat && lng) {
            window.open(`https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}&travelmode=walking`, '_blank');
        } else {
            alert("No hay coordenadas guardadas del auto.");
        }
    }

    window.onload = () => {
        const fin = Number(localStorage.getItem('p_fin'));
        const lat = parseFloat(localStorage.getItem('p_lat'));
        const lng = parseFloat(localStorage.getItem('p_lng'));
        if (Number.isFinite(fin) && fin > Date.now()) {
            document.getElementById('setup').style.display = 'none';
            document.getElementById('active-ui').style.display = 'block';
            btnDetener.style.display = 'none'; // se mostrará cuando suene
            reproducirContador();
            if (Number.isFinite(lat) && Number.isFinite(lng)) {
                mostrarMapa(lat, lng);
            }
        } else {
            // limpiar si expiró o está corrupto
            localStorage.removeItem('p_fin');
        }
    };
</script>
</body>
</html>